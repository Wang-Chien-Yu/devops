@Library('devops') _

pipeline {
  agent {
    kubernetes {
      cloud 'ops_ack'
      inheritFrom 'docker-build'
    }
  }

  stages {
    stage('Docker Login') {
      steps {
        container('docker') {
          dockerUtil(
            action: 'login',
            registry: 'harbor.josh.com',
            credentialsId: 'harbor-admin'
          )
        }
      }
    }

    stage('Build Image') {
      steps {
        container('docker') {
          dockerUtil(
            action: 'build',
            image: 'harbor.josh.com/demo/hello:latest'
          )
        }
      }
    }

    stage('Push Image') {
      steps {
        container('docker') {
          dockerUtil(
            action: 'push',
            image: 'harbor.josh.com/demo/hello:latest'
          )
        }
      }
    }
  }
}
