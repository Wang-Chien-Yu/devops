@Library('devops') _

pipeline {
  agent {
    kubernetes {
      cloud 'ops_ack'
      inheritFrom 'docker-build'
    }
  }

  stages {
    stage('Docker Login') {
      steps {
        dockerUtil(
          action: 'login',
          registry: 'harbor.josh.com:8080',
          credentialsId: 'harbor-admin'
        )
      }
    }

    stage('Build Image') {
      steps {
        dockerUtil(
          action: 'build',
          image: 'harbor.josh.com:8080/demo/hello:latest'
        )
      }
    }

    stage('Push Image') {
      steps {
        dockerUtil(
          action: 'push',
          image: 'harbor.josh.com:8080/demo/hello:latest'
        )
      }
    }
  }
}
