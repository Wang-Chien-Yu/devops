import groovy.transform.Field

@Field def dockerLib
@Field def utils

pipeline {
  agent any

  stages {
    stage('Init') {
      steps {
        script {
          dockerLib = load 'jenkins-libs/docker.groovy'
          utils     = load 'jenkins-libs/utils.groovy'
          utils.logInfo("Libs loaded")
        }
      }
    }

    stage('Docker Login') {
      steps {
        script {
          dockerLib.dockerLogin(
            'harbor.josh.com:8080',
            credentialsId: 'harbor-admin'
          )
        }
      }
    }

    stage('Build') {
      steps {
        script {
          dockerLib.build('demo/test:1.0')
        }
      }
    }

    stage('Push') {
      steps {
        script {
          dockerLib.push('demo/test:1.0')
        }
      }
    }
  }
}
