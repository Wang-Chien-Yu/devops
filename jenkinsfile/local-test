@Library('devops') _

pipeline {
  agent {
    kubernetes {
      cloud 'ops_ack'
      inheritFrom 'docker-build'
    }
  }

  environment {
    PRODUCT     = "loacl"
    TG_GROUP_ID = "-1003393819995"
    TG_BOT_ID   = credentials('telegram-bot-token')
    BUILD_FUNC  = "frontend"
  }

  stages {
    stage('Docker Login') {
      steps {
        container('docker') {
          dockerUtil(
            action: 'login',
            registry: 'harbor.josh.com',
            credentialsId: 'harbor-admin'
          )
        }
      }
    }

    stage('Docker Pull (Verify)') {
      steps {
        container('docker') {
          dockerUtil(
            action: 'pull',
            image: 'harbor.josh.com/demo/hello-harbor:1.0'
          )
        }
      }
    }
  }
}
