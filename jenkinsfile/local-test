def common
def dockerLib
def utils

pipeline {
  agent any

  environment {
    REGISTRY = "harbor.josh.com:8080"
    PROJECT  = "demo"
    IMAGE    = "hello-harbor"
    TAG      = "${env.BUILD_NUMBER}"
  }

  stages {
    stage('Init') {
      steps {
        script {
          common    = load "jenkins-libs/common.groovy"
          dockerLib = load "jenkins-libs/docker.groovy"
          utils     = load "jenkins-libs/utils.groovy"

          utils.logInfo("Successfully loaded libs")
        }
      }
    }

    stage('Docker Login') {
      steps {
        script {
          def dockerLib = load 'jenkins-libs/docker.groovy'

          dockerLib.dockerLogin(
            env.REGISTRY,
            credentialsId: 'harbor-admin'
          )
        }
      }
    }

    stage('Build Image') {
      steps {
        script {
          def dockerLib = load 'jenkins-libs/docker.groovy'

          dockerLib.build(
            "${env.REGISTRY}/${env.PROJECT}/${env.IMAGE}:${env.TAG}"
          )
        }
      }
    }

    stage('Push Image') {
      steps {
        script {
          def dockerLib = load 'jenkins-libs/docker.groovy'
          
          dockerLib.push(
            "${env.REGISTRY}/${env.PROJECT}/${env.IMAGE}:${env.TAG}"
          )
        }
      }
    }
  }

  post {
    success {
      script {
        utils.logSuccess("Build & Push success")
      }
    }
    failure {
      script {
        utils.logError("Pipeline failed")
      }
    }
  }
}
